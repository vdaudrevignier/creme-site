---
import Base from '../layouts/Base.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<Base title="404">
  <div class="container">
    <TerminalWindow title="~/404" command={`cd ${Astro.url.pathname}`}>
      <h1>{t('notFound.title')}</h1>
      <pre class="meme" aria-hidden="true">{`   ¯\\_(ツ)_/¯`}</pre>
      <p class="cursor">{t('notFound.text')}</p>
      <p>
        <a href={localePath(lang, '/')}>&gt; {t('notFound.back')}</a>
      </p>
    </TerminalWindow>
  </div>
</Base>

<style>
  .meme {
    font-size: var(--step-2);
    color: var(--accent-2);
    margin: 0 0 var(--space-3);
  }
</style>
