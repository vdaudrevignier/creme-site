---
import { Image } from 'astro:assets';
import { localePath, type Lang } from '../i18n/ui';
import type { Member } from '../lib/content';

interface Props {
  member: Member;
  lang: Lang;
}

const { member, lang } = Astro.props;
---

<a class="card" href={localePath(lang, `/members/${member.id}`)}>
  <div class="photo">
    <Image src={member.data.photo} alt="" width={400} height={400} fit="cover" />
  </div>
  <span class="name">
    <span class="dim">&gt;</span> {member.data.name}
  </span>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: var(--fg);
  }
  .card:hover {
    background: none;
    color: var(--accent);
  }
  .photo {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--accent);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
    mix-blend-mode: multiply;
    transition: filter 0.2s;
  }
  .card:hover .photo img,
  .card:focus-visible .photo img {
    filter: none;
    mix-blend-mode: normal;
    animation: glitch 0.35s steps(2) 1;
  }
  .name {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    line-height: 1.1;
  }
  @keyframes glitch {
    0% {
      transform: translate(3px, -2px);
      clip-path: inset(10% 0 40% 0);
    }
    50% {
      transform: translate(-3px, 2px);
      clip-path: inset(50% 0 5% 0);
    }
    100% {
      transform: none;
      clip-path: none;
    }
  }
</style>
