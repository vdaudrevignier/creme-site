---
interface Props {
  /** Shown in the title bar, e.g. "~/creme/members". */
  title: string;
  /** Optional command printed as the first prompt line. */
  command?: string;
  id?: string;
  class?: string;
}

const { title, command, id, class: className } = Astro.props;
---

<section class:list={['term', className]} id={id}>
  <div class="titlebar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="title">{title}</span>
    <span class="meter">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </span>
  </div>
  <div class="body">
    {command && (
      <p class="prompt">
        <span class="ps1">creme@crew:{title}$</span> {command}
      </p>
    )}
    <slot />
  </div>
</section>

<style>
  .term {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 0 24px rgb(57 255 122 / 0.06);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--fg-dim);
  }
  .dots i:first-child {
    background: var(--accent-2);
    border-color: var(--accent-2);
  }
  .title {
    flex: 1;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Tiny VU meter, mirrors the 3 dots on the left. */
  .meter {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    width: 42px;
    height: 10px;
    justify-content: flex-end;
  }
  .meter i {
    width: 3px;
    height: 100%;
    background: var(--fg-dim);
    transform-origin: bottom;
    animation: vu 0.9s ease-in-out infinite alternate;
  }
  .meter i:nth-child(2) { animation-duration: 0.6s; animation-delay: -0.2s; }
  .meter i:nth-child(3) { animation-duration: 0.75s; animation-delay: -0.5s; background: var(--accent); }
  .meter i:nth-child(4) { animation-duration: 0.5s; animation-delay: -0.1s; }
  .meter i:nth-child(5) { animation-duration: 1.1s; animation-delay: -0.7s; background: var(--accent-2); }
  @keyframes vu {
    from { transform: scaleY(0.2); }
    to { transform: scaleY(1); }
  }
  .body {
    padding: var(--space-4) var(--space-3);
  }
  .prompt {
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .ps1 {
    color: var(--accent);
  }
</style>
