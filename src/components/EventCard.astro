---
import { Image } from 'astro:assets';
import { formatDate, useTranslations, type Lang } from '../i18n/ui';
import type { Event } from '../lib/content';

interface Props {
  event: Event;
  lang: Lang;
}

const { event, lang } = Astro.props;
const t = useTranslations(lang);
const { title, date, city, venue, address, lineup, url, poster } = event.data;
---

<article class="event">
  {poster && (
    <a class="poster" href={url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      <Image src={poster} alt="" width={480} />
    </a>
  )}
  <div class="info">
    <p class="meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
      <span class="dim">//</span>
      {city}
    </p>
    <h3>{title}</h3>
    <p class="venue">
      @ {venue}
      {address && <span class="dim"> — {address}</span>}
    </p>
    {lineup.length > 0 && (
      <p class="lineup">
        <span class="dim">{t('events.lineup')}:</span> {lineup.join(' / ')}
      </p>
    )}
    {url && (
      <a href={url} target="_blank" rel="noopener">
        [{t('events.link')} ↗]
      </a>
    )}
  </div>
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }
  .poster {
    border: 1px solid var(--line);
  }
  .poster:hover {
    background: none;
    border-color: var(--accent);
  }
  .meta {
    margin: 0;
    color: var(--warn);
    font-size: var(--step--1);
  }
  h3 {
    margin: var(--space-1) 0;
  }
  .venue,
  .lineup {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
  }
  @media (max-width: 30rem) {
    .event {
      grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
    }
  }
</style>
